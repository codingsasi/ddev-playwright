#!/bin/bash
#ddev-generated
## Description: Reinstall Playwright browsers (even if already installed)
## Usage: reinstall-browsers
## Example: "ddev reinstall-browsers"

set -e

export PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

TEST_DIR="${PLAYWRIGHT_TEST_DIR:-tests}"
PW_DIR="/var/www/html/${TEST_DIR}/playwright"

if [ ! -f "${PW_DIR}/package.json" ]; then
  echo "Playwright project not found. Run 'ddev install-playwright' first."
  exit 1
fi

source ~/.nvm/nvm.sh 2>/dev/null || true
cd "${PW_DIR}"
[ -f .nvmrc ] && nvm use 2>/dev/null || nvm use 22 2>/dev/null || true

echo "Reinstalling Playwright browsers..."
npx playwright install chromium firefox webkit
touch /opt/playwright-browsers/.installed 2>/dev/null || true
echo "✓ Browsers reinstalled at /opt/playwright-browsers"
