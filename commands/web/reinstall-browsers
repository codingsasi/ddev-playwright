#!/bin/bash
#ddev-generated
## Description: Reinstall Playwright browsers (even if already installed)
## Usage: reinstall-browsers
## Example: "ddev reinstall-browsers"

set -e

export PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

TEST_DIR="${PLAYWRIGHT_TEST_DIR:-tests}"
PW_DIR="/var/www/html/${TEST_DIR}/playwright"

if [ ! -f "${PW_DIR}/package.json" ]; then
  echo "Playwright project not found. Run 'ddev install-playwright' first."
  exit 1
fi

source ~/.nvm/nvm.sh 2>/dev/null || true
cd "${PW_DIR}"
# Honor the project's .nvmrc (single source of truth); install it if absent,
# falling back to the configured default. Playwright requires Node >= 18.
nvm use 2>/dev/null || nvm install 2>/dev/null || nvm use "${PLAYWRIGHT_NODE_VERSION:-lts/*}" 2>/dev/null || true

# Resolve the *actual* installed Playwright version so the marker we manage
# matches the one written by install-playwright / the post-start hook.
ACTUAL_VERSION=$(node -p "require('${PW_DIR}/node_modules/@playwright/test/package.json').version" 2>/dev/null || echo "")
if [ -z "${ACTUAL_VERSION}" ]; then
  echo "Could not resolve installed @playwright/test version. Run 'ddev install-playwright' first."
  exit 1
fi

export PLAYWRIGHT_BROWSERS_PATH="/opt/playwright-browsers/${ACTUAL_VERSION}"
mkdir -p "${PLAYWRIGHT_BROWSERS_PATH}"

echo "This will refresh browsers for Playwright ${ACTUAL_VERSION} in the shared volume"
echo "(${PLAYWRIGHT_BROWSERS_PATH}). Other versions' subdirectories are not affected."
read -r -p "Do you want to continue? [y/n]: " CONFIRM_REINSTALL
case "${CONFIRM_REINSTALL}" in
  y|Y|yes|YES)
    echo "Reinstalling Playwright browsers for ${ACTUAL_VERSION}..."
    ;;
  *)
    echo "Aborted. Existing browsers were not modified."
    exit 0
    ;;
esac

rm -f "${PLAYWRIGHT_BROWSERS_PATH}/.installed"
npx playwright install --force chromium firefox webkit
touch "${PLAYWRIGHT_BROWSERS_PATH}/.installed" 2>/dev/null || true
echo "Browsers for Playwright ${ACTUAL_VERSION} reinstalled in shared volume"
