#!/bin/bash
#ddev-generated

## Description: Run Playwright tests with persistent browser installation
## Usage: playwright [flags] [args]
## Example: "ddev playwright --help" or "ddev playwright test"
## ExecRaw: true

set -e

# Resolve the actual @playwright/test version from the local install and
# point PLAYWRIGHT_BROWSERS_PATH at the matching per-version subdirectory of
# the shared volume.
TEST_DIR_CHECK="${PLAYWRIGHT_TEST_DIR:-tests}"
PW_DIR_CHECK="/var/www/html/${TEST_DIR_CHECK}/playwright"
ACTUAL_VERSION=$(node -p "require('${PW_DIR_CHECK}/node_modules/@playwright/test/package.json').version" 2>/dev/null || echo "")
if [ -z "${ACTUAL_VERSION}" ] || [ ! -f "/opt/playwright-browsers/${ACTUAL_VERSION}/.installed" ]; then
    echo "Playwright browsers not found in shared volume!"
    echo "Please run: ddev install-playwright"
    exit 1
fi
export PLAYWRIGHT_BROWSERS_PATH="/opt/playwright-browsers/${ACTUAL_VERSION}"

# Skip browser download since we have them pre-installed
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Make nvm available; the version itself comes from the run dir's .nvmrc below.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[ -s "${NVM_DIR}/nvm.sh" ] && source "${NVM_DIR}/nvm.sh"

# Select the Node version from .nvmrc in the current dir (single source of
# truth). Playwright requires Node >= 18 and nvm's default alias may be older;
# `nvm use`/`nvm install` both read .nvmrc, so call this AFTER cd-ing into the
# run dir. Falls back to the configured default, then to whatever is current.
select_node() {
    command -v nvm &>/dev/null || return 0
    nvm use 2>/dev/null || nvm install 2>/dev/null || nvm use "${PLAYWRIGHT_NODE_VERSION:-lts/*}" 2>/dev/null || true
}

# Auto-detect: if a playwright.config.ts/js exists at the project root, use it directly.
# This supports projects that manage their own Playwright setup (e.g. with an e2e/ directory)
# without needing the tests/playwright/ scaffold this addon creates by default.
if [ -f /var/www/html/playwright.config.ts ] || [ -f /var/www/html/playwright.config.js ]; then
    cd /var/www/html || exit 1
    select_node
    npx playwright "$@"
else
    # Fall back to addon-managed scaffold directory
    TEST_DIR="${PLAYWRIGHT_TEST_DIR:-tests}"
    cd "/var/www/html/${TEST_DIR}/playwright" || exit 1
    select_node
    if [ -f yarn.lock ]; then
        yarn && yarn playwright "$@"
    elif [ -f package-lock.json ]; then
        npm ci && npx playwright "$@"
    else
        npm install && npx playwright "$@"
    fi
fi