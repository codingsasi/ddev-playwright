#ddev-generated
# This Dockerfile installs Playwright system dependencies and the Playwright
# CLI into the web container. Browsers themselves live in a shared Docker
# volume (ddev-playwright-browsers) mounted at /opt/playwright-browsers, so
# they are NOT downloaded during image build — see docker-compose.playwright.yaml.

ARG BASE_IMAGE
FROM $BASE_IMAGE
ARG PLAYWRIGHT_VERSION=latest

# Install system dependencies for Playwright browsers
# These are required for Chrome, Firefox, and WebKit to run properly
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Dependencies for Chrome
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libatspi2.0-0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libxcb1 \
    libxkbcommon0 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    # Dependencies for Firefox
    libgtk-3-0 \
    libxtst6 \
    # Dependencies for WebKit
    libwoff1 \
    libopus0 \
    libwebp7 \
    libwebpdemux2 \
    libenchant-2-2 \
    libgudev-1.0-0 \
    libsecret-1-0 \
    libhyphen0 \
    libmanette-0.2-0 \
    libgdk-pixbuf-2.0-0 \
    libegl1 \
    libnotify4 \
    libxslt1.1 \
    libevent-2.1-7 \
    libgles2 \
    libgstreamer-gl1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    gstreamer1.0-libav \
    libxshmfence1 \
    libglu1 \
    # Fonts so browsers render Unicode correctly in tests — without these,
    # CJK text and emoji show as tofu/blank boxes (see issue #8):
    #   noto-core  = broad Latin/Greek/Cyrillic and many scripts
    #   noto-cjk   = Chinese, Japanese, Korean
    #   noto-color-emoji = color emoji glyphs
    fonts-noto-core \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers

# Pre-create the browsers directory world-writable. When the shared volume
# (ddev-playwright-browsers) is mounted onto an empty fresh volume, Docker
# initializes the volume from this directory, so the volume inherits 0777
# perms — the non-root web user can then write to it.
RUN mkdir -p /opt/playwright-browsers && chmod 777 /opt/playwright-browsers

SHELL ["/bin/bash", "-c"]
# Build-time bootstrap Node, installed via NodeSource's current-LTS channel.
# This node is used ONLY to run `playwright install-deps` below, which installs
# OS-level (apt) browser dependencies and is entirely Node-version agnostic.
#
# The RUNTIME Node version is NOT decided here — it comes from the project's
# tests/playwright/.nvmrc (seeded from PLAYWRIGHT_NODE_VERSION) via nvm, so this
# add-on is not pinned to any single Node major. We use the LTS channel rather
# than a hardcoded major so the bootstrap itself tracks a supported release.
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/* && \
    node --version && npm --version

# Install the Playwright CLI globally and run install-deps (writes to /usr,
# not the volume). Browsers themselves are downloaded at runtime by
# `ddev install-playwright` into the shared volume.
RUN npm install -g playwright@${PLAYWRIGHT_VERSION} && \
    npx playwright install-deps && \
    npm cache clean --force

# Best-effort: pre-bake the configured Node version into nvm so the first
# `ddev start` doesn't pay a runtime `nvm install`. Never fails the build — if
# nvm isn't available at image-build time (add-on ordering), the post-start
# hook installs the version at runtime instead.
ARG NODE_VERSION=lts/*
RUN export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"; \
    if [ -s "${NVM_DIR}/nvm.sh" ]; then \
      source "${NVM_DIR}/nvm.sh" && nvm install "${NODE_VERSION}" || true; \
    else \
      echo "nvm not present at build time; runtime hook will install Node ${NODE_VERSION}"; \
    fi

EXPOSE 9323
